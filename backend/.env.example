# Server
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Database (SQLite by default; switch provider in prisma/schema.prisma for PostgreSQL)
DATABASE_URL=file:../data/launcher.db

# Security: secret used to derive the AES-256-GCM key that encrypts tokens at rest.
# If empty, a random key is generated and stored under data/.secret (recommended only for dev).
LAUNCHER_SECRET=

# Yggdrasil (authlib-injector) auth server base URL (LittleSkin by default)
YGG_BASE_URL=https://littleskin.cn/api/yggdrasil

# Paths (defaults are resolved relative to the backend/ directory)
DATA_DIR=./data
INSTANCES_DIR=./instances
DOWNLOADS_DIR=./downloads

# Launcher behaviour
LAUNCHER_NAME=NodeLauncher
LAUNCHER_VERSION=0.1.0
DOWNLOAD_CONCURRENCY=8
HTTP_TIMEOUT_MS=30000
