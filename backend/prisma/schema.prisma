generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                  String             @id @default(cuid())
  /// offline | yggdrasil
  type                String
  /// offline player name or yggdrasil profile name
  username            String             @unique
  /// encrypted yggdrasil access token
  accessToken         String?
  /// encrypted yggdrasil client token
  clientToken         String?
  accessTokenExpiresAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  profiles            MinecraftProfile[]
  sessions            LaunchSession[]
}

model MinecraftProfile {
  id          String   @id
  name        String
  accountId   String
  isActive    Boolean  @default(false)
  skins       String?
  capes       String?
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, name])
}

model Instance {
  id               String          @id @default(cuid())
  name             String
  minecraftVersion String
  /// vanilla | fabric | forge | neoforge | quilt
  loader           String          @default("vanilla")
  loaderVersion    String?
  javaPath         String?
  memoryMinMb      Int?
  memoryMaxMb      Int             @default(2048)
  /// extra JVM args, JSON array of strings
  jvmArgs          String?
  /// extra game variables, JSON object Record<string,string>
  gameArgs         String?
  width            Int?
  height           Int?
  fullscreen       Boolean         @default(false)
  serverIp         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         LaunchSession[]
  contentOverrides ContentOverride[]
  installedContents InstalledContent[]
}

model JavaRuntimeRecord {
  id             String   @id @default(cuid())
  path           String   @unique
  majorVersion   Int
  architecture   String
  vendor         String?
  versionString  String?
  /// system | managed | explicit
  source         String   @default("system")
  lastVerifiedAt DateTime @default(now())
}

/// Tracks user enable/disable for content whose real state cannot be derived
/// purely from a filename suffix (resource packs, shader packs; later datapacks).
/// worldName defaults to "" for instance-scoped kinds.
model ContentOverride {
  id         String   @id @default(cuid())
  instanceId String
  /// mod | resourcepack | shaderpack | datapack
  kind       String
  fileName   String
  enabled    Boolean  @default(true)
  worldName  String   @default("")
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, kind, fileName, worldName])
}

model DownloadTaskRecord {
  id            String    @id
  kind          String
  url           String
  targetPath    String
  status        String
  bytesTotal    Int?
  bytesDone     Int       @default(0)
  error         String?
  /// expected integrity hash source (sha1 | sha512)
  hashAlgorithm String?
  hashValue     String?
  /// download source label, e.g. official | bmclapi | modrinth | curseforge
  provider      String?
  priority      Int       @default(0)
  retryCount    Int       @default(0)
  /// full ordered mirror list (JSON array) so a task can be resumed after restart
  urlsJson      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  finishedAt    DateTime?

  @@index([status, updatedAt])
}

/// Catalog entry for a marketplace ({Modrinth | CurseForge}) project. Imported
/// lazily on first use; lets us track install source, update and sync.
model MarketItem {
  id         String    @id @default(cuid())
  /// modrinth | curseforge
  provider   String
  /// provider-internal id (e.g. Modrinth project slug/id)
  externalId String
  name       String
  /// mod | modpack | resourcepack | shader | world
  type       String
  slug       String?
  description String?
  author     String?
  iconUrl    String?
  website    String?
  downloads  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  versions MarketVersion[]
  installed InstalledContent[]

  @@unique([provider, externalId])
}

/// A specific downloadable release of a market project (e.g. Sodium 0.5.11 for 1.21).
model MarketVersion {
  id                 String     @id @default(cuid())
  itemId             String
  item               MarketItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  versionName        String
  /// comma-separated supported Minecraft versions
  minecraftVersions  String
  /// fabric | forge | neoforge | quilt | vanilla | null
  loader             String?
  fileUrl            String
  fileName           String
  fileSize           Int
  hashAlgorithm      String?
  hashValue          String?
  dependencies       Json?
  releaseDate        DateTime?

  dependenciesList ContentDependency[]
}

/// Resolved dependency edges between market versions (e.g. Create -> Fabric API).
model ContentDependency {
  id               String         @id @default(cuid())
  parentVersionId  String
  dependencyId     String
  required         Boolean        @default(true)
  parentVersion    MarketVersion  @relation(fields: [parentVersionId], references: [id], onDelete: Cascade)

  @@index([parentVersionId])
}

/// Records that a marketplace project was installed into an instance (or
/// instance-less for modpacks), enabling update / uninstall / sync.
model InstalledContent {
  id           String     @id @default(cuid())
  instanceId   String?
  marketItemId String
  versionId    String
  /// mod | modpack | resourcepack | shader | world
  type         String
  fileName     String
  enabled      Boolean    @default(true)
  installedAt  DateTime   @default(now())
  marketItem   MarketItem @relation(fields: [marketItemId], references: [id], onDelete: Cascade)
  instance     Instance?  @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
}

model LaunchSession {
  id           String    @id @default(cuid())
  instanceId   String
  accountId    String?
  pid          Int?
  /// starting | running | stopping | stopped | crashed
  status       String    @default("starting")
  commandJson  String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  exitCode     Int?
  crashReason  String?
  instance     Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  account      Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
